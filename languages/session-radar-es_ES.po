msgstr "Session Radar · Presencia"

msgid "Authenticated WordPress sessions"
msgstr "Sesiones autenticadas de WordPress"

msgid "Auto"
msgstr "Auto"

msgid "Automatic refresh, not real-time presence"
msgstr "Actualización automática, no presencia en tiempo real"

msgid "Browser"
msgstr "Navegador"

msgid "Disabled by default. Session Radar does not collect additional IP addresses; it reads data already associated with WordPress sessions."
msgstr "Desactivado de forma predeterminada. Session Radar no recopila direcciones IP adicionales; lee los datos ya asociados con las sesiones de WordPress."

msgid "Inactive"
msgstr "Inactivo"

msgid "Inactivity threshold"
msgstr "Umbral de inactividad"

msgid "Last activity detected in WordPress admin"
msgstr "Última actividad detectada en la administración de WordPress"

